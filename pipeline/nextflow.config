// Perfil para correr nf-core/rnaseq en tu infraestructura de AWS.
// Se activa con:  -profile aws   (o test,aws para la prueba)

profiles {
  aws {
    // --- Dónde corren las tareas: AWS Batch ---
    process.executor  = 'awsbatch'
    process.queue     = 'kras-rnaseq-queue'          // output: job_queue_name
    aws.region        = 'us-east-2'          // tu región
    aws.batch.jobRole = 'arn:aws:iam::201507414770:role/kras-rnaseq-batch-job'          // output: batch_job_role_arn

    // --- Dónde viven los archivos intermedios: S3 ---
    workDir = 's3://kras-rnaseq-201507414770/work'          // output: bucket_name (work/ se borra a los 7 días)

    // --- Acceso a S3 desde los contenedores ---
    wave.enabled    = true             // prepara los contenedores y les agrega Fusion
    fusion.enabled  = true             // monta S3 como si fuera un disco
    process.scratch = false            // requisito de Fusion

    // --- Tope por tarea: que nada pida más de lo que cabe en tus máquinas ---
    process.resourceLimits = [cpus: 16, memory: '120.GB', time: '24.h']
  }
}
